######################### READ ME FIRST! #########################
# You are meant to copy this file and update the defines below
# for your own machine; these defines should be kept LOCAL ONLY
# as some of them (e.g. API keys) should actually be kept secret.
#
# For compatibility reasons with some libraries that do not try
# to expand variables properly (e.g. HuggingFace), avoid putting
# references to other variables inside your definitions.
##################################################################

#PYINE_DATA_ROOT=???  # update if you do not store your datasets in <repo_root>/data
#PYINE_CACHE_ROOT=???  # update if you do not want cached data in <repo_root>/data/cache
#PYINE_LOGS_ROOT=???  # update if you do not want logs/outputs in <repo_root>/logs

#DEEPSEEK_API_KEY=???  # update with proper value and uncomment if needed!
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

#OPENAI_API_KEY=???  # update with proper value and uncomment if needed!
OPENAI_BASE_URL=https://api.openai.com/v1

#HF_TOKEN=???  # REQUIRED for multi-node training! Create at https://huggingface.co/settings/tokens
#HF_DATASETS_CACHE=???  # update with shared drive if you want to move it out of your home
#HF_HUB_CACHE=???  # update with shared drive if you want to move it out of your home

#WANDB_API_KEY=???  # update with proper value and uncomment if needed!
WANDB_PROJECT=pyine

TENSORBOARD_LOG_DIR=./logs/tensorboard/
TMP_DIR=/tmp/pyine/
LOGLEVEL=INFO

# toggle graceful shutdown signal handlers (set to off to skip registration)
#PYINE_ENABLE_GRACEFUL_SHUTDOWN_SIGNALS=off

# multi-node data preparation (advanced, usually auto-detected):
#  - when running on multiple nodes, data prep can run in parallel on each node's local rank 0;
#  - this is auto-enabled when cache is on local storage (not NFS/Lustre/GPFS).
#PYINE_PER_NODE_PREP=auto  # on|off|auto - override filesystem-based detection
#PYINE_BARRIER_TOKEN=???   # explicit job token for barrier namespacing (usually auto-derived)
#PYINE_SKIP_DDP_INIT=off   # set to "on" to skip early torch.distributed initialization
