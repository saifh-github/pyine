# An .aiignore file follows the same syntax as a .gitignore file.
# .gitignore documentation: https://git-scm.com/docs/gitignore

# Project data / results directories
/data/
/datasets/
/results/
/output/
/logs/
/wandb/

# Byte-compiled / optimized / temp files
__pycache__/
*.py[cod]
*$py.class
*.tmp*

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# Testing
.coverage
htmlcov/
.pytest_cache/

# Local development settings
.env
.env.local

# Logs
*.log

# OS specific
.DS_Store
Thumbs.db
